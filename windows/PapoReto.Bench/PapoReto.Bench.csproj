<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>papo-reto-bench</AssemblyName>
    <!-- Prints 3.68 like the Mac bench, not 3,68 under a pt-BR Windows. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PapoReto.Core/PapoReto.Core.csproj" />
    <ProjectReference Include="../PapoReto.Sherpa/PapoReto.Sherpa.csproj" />
  </ItemGroup>
</Project>
