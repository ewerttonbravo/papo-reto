<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Built on the Mac (ADR-027). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Drawn by make win-app from the Mac's ProfileGlyph.swift (W12); CI builds on Ubuntu without AppKit, so without it. -->
    <ApplicationIcon Condition="Exists('$(MSBuildThisFileDirectory)../../build/windows/icons/PapoReto.ico')">$(MSBuildThisFileDirectory)../../build/windows/icons/PapoReto.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PapoReto.Core/PapoReto.Core.csproj" />
    <ProjectReference Include="../PapoReto.Sherpa/PapoReto.Sherpa.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- WASAPI capture with Windows converting to 16 kHz mono; its MMDevice IDs serve W05. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
</Project>
